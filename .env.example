# Deployment surface and application profile are independent. A deployed Demo
# still uses the virtual ledger and disposable Demo namespace.
ANTIFRAUD_DEPLOYMENT_STAGE=local
ANTIFRAUD_NETWORK_KIND=demo
ANTIFRAUD_DEMO_MODE=true
ANTIFRAUD_DEMO_RETENTION_DAYS=7
ANTIFRAUD_TEST_NETWORK_ENABLED=false
ANTIFRAUD_PRODUCTION_ENABLED=false

# Server-only credentials shared separately with each portal BFF. Use four
# generated secrets outside source control; never expose this JSON to browser
# variables or logs.
ANTIFRAUD_DEMO_BFF_TOKENS_JSON={"controller":"replace-with-at-least-16-random-characters","professional":"replace-with-at-least-16-random-characters","personal":"replace-with-at-least-16-random-characters","social":"replace-with-at-least-16-random-characters"}

# Cloud Run injects PORT. Local execution defaults to the existing fixture port.
PORT=3700

# Demo persistence may use memory locally or a disposable namespaced cloud
# adapter when deployed. The browser never selects these values.
ANTIFRAUD_DOCUMENT_BACKEND=memory
ANTIFRAUD_OBJECT_BACKEND=memory
ANTIFRAUD_COLLECTION_PREFIX=antifraud_demo_
# Required with Firestore so a new process reconstructs the same managed wallet
# and can unseal existing JWE attachments. Inject from Secret Manager.
ANTIFRAUD_DEMO_WALLET_SEED=replace-with-at-least-32-random-characters

# Required only for local-network or Test Network. These values identify the
# governed peer connection and enrolled service identity. Channel and chaincode
# selection remains trusted manager policy and is deliberately absent here.
ANTIFRAUD_FABRIC_PEER_ENDPOINT=localhost:7051
ANTIFRAUD_FABRIC_PEER_HOST_ALIAS=peer0-host1
ANTIFRAUD_FABRIC_TLS_ROOT_CERT=/absolute/path/to/peer/tls/ca.crt
ANTIFRAUD_FABRIC_MSP_ID=Host1MSP
ANTIFRAUD_FABRIC_CERTIFICATE=/absolute/path/to/service/msp/signcerts/cert.pem
ANTIFRAUD_FABRIC_PRIVATE_KEY=/absolute/path/to/service/msp/keystore/private-key
